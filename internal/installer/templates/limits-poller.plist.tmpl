<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{{LABEL_PREFIX}}.limits-poller</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>{{OBS_DIR}}/bin/limits-poller.sh</string>
  </array>
  <key>WorkingDirectory</key><string>{{OBS_DIR}}</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{OBS_DIR}}/logs/poller.log</string>
  <key>StandardErrorPath</key><string>{{OBS_DIR}}/logs/poller.err</string>
</dict></plist>
