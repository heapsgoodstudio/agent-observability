# Build artefacts, machine-local state, and machine/editor noise.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# direnv (`use flake`) writes its cached profile here, per directory.
.direnv/

# Nix build symlink, dropped wherever `nix build` was run.
result
result-*

# Claude Code working state. Shared configuration under .claude/ (settings,
# agents, skills, commands) is meant to be committed; these two are not.
# settings.local.json holds per-developer permission grants, and worktrees/
# is a scratch checkout area.
.claude/settings.local.json
.claude/worktrees/

# Superpowers scratch state.
.superpowers/

# Python bytecode, from any ad-hoc scripting.
__pycache__/
*.py[cod]

# Machine-local config, written by `claude-obs install` from
# config.env.example. Holds absolute paths for this machine only.
config.env
*.bak

# Runtime state. Never a source directory: the installed stack keeps its
# store binaries, databases, logs and VictoriaMetrics/VictoriaLogs data
# under <install-dir>/state, and nothing here is checked in.
state/

# The installed OutRoot (<install-dir>/dashboard/data), where the analysis
# and advice runners write real reports. Not a source directory either, but
# ignored so a dev pointing an install at this checkout cannot commit one.
dashboard/data/

# Anchored to the repository root: an unanchored `dist/` would also match
# internal/server/dist/ (git treats a slash-free pattern as matching a
# directory of that name at any depth), which would swallow the committed
# placeholder README.md below along with it.
/dist/

# Frontend build output and dependencies.
frontend/node_modules/
frontend/out/
frontend/.next/

# Regenerated by every `next dev`/`next build` and references a path inside
# the already-ignored frontend/.next/, so committing it just goes stale.
frontend/next-env.d.ts

# tsconfig.json's "incremental": true writes this cache on every
# `tsc --noEmit` (which `just test` runs), even though noEmit means no other
# output; regenerated every run, never useful to commit.
frontend/tsconfig.tsbuildinfo

# The static export `just build` copies in before `go:embed` picks it up.
# The README.md placeholder is committed so the embed directive has a
# directory to point at on a fresh clone.
internal/server/dist/*
!internal/server/dist/README.md
