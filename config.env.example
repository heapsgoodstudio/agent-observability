# Agent Observability: local Claude Code telemetry stack. `claude-obs install`
# writes config.env from this file; config.env is gitignored and machine-local.

# Locates the install dir; do not edit. Never the source checkout: the
# scripts here refuse to run from one.
OBS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Profile configuration is owned by profiles.json and managed in Settings.
# These Claude-only shell values are generated from enabled profiles. Explicit
# empties are valid: installing with no agent profiles still starts the dashboard.
PROFILE_DIR=""
PROFILE_DIRS=""
PROFILE_IDS=""
PROFILES_REGISTRY=1

# Optional, explicit attribution of billing history from the old single-account
# collector, which recorded no account/profile labels. Set only after confirming
# its historical owner: a provider-qualified key such as claude:ACCOUNT_ID.
# Blank keeps those observations out of every account. Does not rewrite data.
LEGACY_CLAUDE_BILLING_ACCOUNT=""

# Absolute path to the claude binary (headless analysis runs use it).
CLAUDE_BIN=""

# launchd label prefix for the six agents.
LABEL_PREFIX="com.agent-observability"

# Stores and dashboard. The ports the stack actually listens on are Go consts
# in internal/server/server.go (DashPort/VMPort/VLPort), coupled there with
# the matching launchd template port literals; claude-obs serve does not read
# either key below. VM_URL backs one flag default on claude-obs backfill, and
# DASH_PORT is the base for the deep links bin/usage-alert.sh puts in its
# notification banners.
VM_URL="http://127.0.0.1:8428"
DASH_PORT=8427

# Store binaries. bin/fetch-stores.sh downloads these into state/bin and
# verifies them against the checksums file published beside each release. Bump deliberately:
# the old container images tracked :latest, which picked up fixes silently
# and meant nobody could say which version they were running.
# VictoriaMetrics v1.153.0 is skipped: its darwin build can fail to read valid
# data blocks and crash (VictoriaMetrics issue #11683).
VM_VERSION="v1.152.0"
VL_VERSION="v1.53.0"

# Refreshing the billed figure. The poller asks Claude Code for its usage data
# through the control protocol's get_usage request, because otherwise that
# figure only changes when someone runs /usage in a session. Measured at 2.7s
# per probe, no model tokens and no transcript. Claude Code only rewrites its
# cache every 5 minutes, so probing more often than MIN_AGE just spawns
# processes. Set USAGE_PROBE=0 to go back to waiting for /usage.
USAGE_PROBE=1
USAGE_PROBE_MIN_AGE_S=300  # only probe when the billed figure is older than this
USAGE_PROBE_TIMEOUT_S=30   # backstop; the probe normally exits on its own

# Alerting thresholds.
STALE_AFTER_S=600          # compatibility; Claude dashboard/API use a fixed 10-minute limit
WARN_PCTS="75 90 100"      # plan-window crossing notifications
OVERAGE_WARN_PER_HR=100    # USD/hr real overage burn, warning
OVERAGE_CRIT_PER_HR=250    # USD/hr real overage burn, critical
DAILY_BUDGET_USD=750       # retired notional alert; retained for upgrade compatibility
USAGE_STALE_ALERT_S=21600  # alert when in overage and the billed figure is staler than this
DRY_RUN="${DRY_RUN:-0}"    # 1 = alerts print instead of notify

# Click-to-open banners. claude-obs install builds notifier/ into this bundle; clicking
# an alert opens the dashboard at the relevant section. It must live in a real
# applications directory: macOS refuses notification authorization to bundles
# inside this checkout. Set empty to disable, and alerts fall back to osascript
# banners that do nothing when clicked.
NOTIFIER_APP="$HOME/Applications/Agent Observability.app"

# Metric names exported by Claude Code's OTel exporter.
COST_METRIC="claude_code.cost.usage"
TOKEN_METRIC="claude_code.token.usage"

# Whether GetUsageSnapshot may fetch live usage on request, rather than only
# serving what the poller last collected. Off by default: a probe is a full
# Claude Code startup, hooks and all, and a server that spawns those on request
# is a bigger thing than an observability read should be. The poller already
# refreshes every profile every five minutes. With this off, GetUsageSnapshot
# ignores max_age_s and says so through on_demand_probe_enabled.
USAGE_ON_DEMAND_PROBE=0

# The dollar price of one Codex credit, such as 0.04. Codex reports the credits
# it spends once the included allowance is used up, never dollars, and OpenAI's
# price per credit depends on the plan, so take it from the workspace's billing.
# Empty shows Codex overage in credits only. Read when the server starts.
CODEX_CREDIT_USD=
